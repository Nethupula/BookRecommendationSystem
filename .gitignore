*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============================================================
# Virtual Environments
# ============================================================
venv/
venv*/
.venv/
env/
env*/
ENV/

# ============================================================
# IDEs & Editors
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ============================================================
# Jupyter Notebooks
# ============================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ============================================================
# Environment Variables & Secrets
# ============================================================
.env
.env.*
*.env
.streamlit/secrets.toml

# ============================================================
# Datasets (Large Data Files)
# ============================================================
# Ignore all raw data files and folders
data/*
!data/.gitkeep
!data/processed/

# Inside data/processed, ignore everything by default
data/processed/*
!data/processed/.gitkeep

# Allowed processed dataset files for the application
!data/processed/books_clean.csv
!data/processed/ratings_clean.csv

# Ignore large raw dataset archives
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.parquet
*.feather

# ============================================================
# Model Artifacts & Weights
# ============================================================
# Ignore all models by default (prevents committing >1GB matrix files)
models/*
!models/.gitkeep

# Allowed model artifacts required for the application
!models/tfidf_vectorizer.joblib
!models/tfidf_matrix.joblib
!models/content_model.joblib
!models/neural_recommender.keras
!models/user_to_index.joblib
!models/book_to_index.joblib

# ============================================================
# Logs & Testing
# ============================================================
*.log
*.tmp
*.temp
.pytest_cache/
.coverage
htmlcov/

# ============================================================
# Operating System Files
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
