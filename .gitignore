# ============================================================
# Python & Bytecode
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============================================================
# Virtual Environments
# ============================================================
venv/
venv*/
.venv/
env/
env*/
ENV/

# ============================================================
# IDEs & Editors
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ============================================================
# Jupyter Notebooks
# ============================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ============================================================
# Environment Variables & Secrets
# ============================================================
.env
.env.*
*.env
.streamlit/secrets.toml

# ============================================================
# Datasets (Large Data Files)
# ============================================================
data/*
!data/.gitkeep
!data/processed/
data/processed/*
!data/processed/.gitkeep

# Ignore common large raw dataset archives and formats
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.parquet
*.feather

# ============================================================
# Model Artifacts & Weights (Exclude Large Binaries > 100MB)
# ============================================================
models/*
!models/.gitkeep

# Catch any standalone model binaries
*.pkl
*.pickle
*.joblib
*.keras
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.safetensors

# ============================================================
# Logs & Testing
# ============================================================
*.log
*.tmp
*.temp
.pytest_cache/
.coverage
htmlcov/

# ============================================================
# Operating System Files
# ============================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
